# logrotate fragment for the rust-junosmcp JSON audit sink.
#
# Install as /etc/logrotate.d/rust-junosmcp-audit (root:root, mode 0644).
# Enable the sink by passing --audit-log-file (or JMCP_AUDIT_LOG_FILE). The
# path below matches the packaged systemd unit, which runs as jmcp:jmcp with
# StateDirectory=jmcp (/var/lib/jmcp writable under ProtectSystem=strict).
# Adjust paths/retention to your policy.
#
# Rename + reopen, not copytruncate:
#   The server keeps the AuditFileSink handle mecmcp_audit::init_tracing
#   returns and reopens it by path on SIGHUP, alongside the existing
#   devices.json/tokens.json hot reload. logrotate renames the file below,
#   sends SIGHUP through `postrotate`, and every write after that point goes
#   to a fresh inode at the same path. Nothing written before the rename is
#   truncated and nothing written after it is lost — unlike copytruncate,
#   which drops whatever lands between its copy and its truncate.

/var/lib/jmcp/audit.jsonl {
    daily
    rotate 14
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    su jmcp jmcp
    postrotate
        systemctl kill -s HUP rust-junosmcp.service >/dev/null 2>&1 || true
    endscript
}
